<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>RedBird.Abstractions</RootNamespace>
    <Title>RedBird.NET Abstractions</Title>
    <Description>Backend-agnostic contracts (interfaces, delegates, exceptions, policy enums, and ABI descriptors) shared by RedBird hooking packages. Has no dependency on an architecture implementation.</Description>
    <PackageTags>Interop;Hooking;Abstractions</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
