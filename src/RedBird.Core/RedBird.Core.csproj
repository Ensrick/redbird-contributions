<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>RedBird.Core</RootNamespace>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Title>RedBird.NET Core</Title>
    <Description>Architecture-agnostic foundation: Windows P/Invoke surface, native memory allocation/pooling, pattern scanning, managed native-memory wrappers, and Iced code reader/writer adapters shared by every architecture-specific hooking backend.</Description>
    <PackageTags>Interop;Memory;Pattern Scanning;Iced</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedBird.Abstractions\RedBird.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
    Replace the SDK's automatically discovered None item with an explicit package item.

    Remove prevents the same file from being included twice. 
    Include adds it back only after the native Linux helper has been built. 
    Pack places the library in NuGet's standard Linux x64 native-runtime directory, allowing consuming projects to resolve it as a runtime asset.

    CopyToOutputDirectory and CopyToPublishDirectory also place the library alongside RedBird.Core.dll during local builds and publishing. 
    PreserveNewest avoids copying it again when the destination is already current. 
    Link and TargetPath give the copied output the simple filename "libredbird_thread_patch.so".
  -->
    <None Remove="runtimes/linux-x64/native/libredbird_thread_patch.so" />
    <None Include="$(MSBuildProjectDirectory)/runtimes/linux-x64/native/libredbird_thread_patch.so"
          Condition="Exists('$(MSBuildProjectDirectory)/runtimes/linux-x64/native/libredbird_thread_patch.so')"
          Pack="True"
          PackagePath="runtimes/linux-x64/native/"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Link="libredbird_thread_patch.so"
          TargetPath="libredbird_thread_patch.so" />
  </ItemGroup>
</Project>
