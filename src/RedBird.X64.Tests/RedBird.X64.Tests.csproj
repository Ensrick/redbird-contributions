<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single-target: the libraries multi-target net10.0;net48, but the POSIX layer and the
      NativeLibrary-based resolution only exist on the modern TFM, and these tests exercise them.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RedBird.X64.Tests</RootNamespace>
    <AssemblyName>RedBird.X64.Tests</AssemblyName>

    <!-- The suite assembles and executes real x86-64 machine code, so the host must be x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>

    <!--
      CI runs xUnit v3's executable directly. 
    -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <GenerateProgramFile>false</GenerateProgramFile>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

    <!-- Test code is deliberately sparse on XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedBird.Core\RedBird.Core.csproj" />
    <ProjectReference Include="..\RedBird.Backends.NativeX64\RedBird.Backends.NativeX64.csproj" />
    <ProjectReference Include="..\RedBird.Backends.NativeX86\RedBird.Backends.NativeX86.csproj" />
    <ProjectReference Include="..\RedBird.Backends.PolyHook2\RedBird.Backends.PolyHook2.csproj" />
    <ProjectReference Include="..\RedBird.Backends.MinHook\RedBird.Backends.MinHook.csproj" />
    <ProjectReference Include="..\RedBird.Extensions.CallingConventions\RedBird.Extensions.CallingConventions.csproj" />
    <ProjectReference Include="..\RedBird.X64\RedBird.X64.csproj" />
  </ItemGroup>

</Project>
