{
  "name": "redbird-release-tooling",
  "version": "0.0.0-development",
  "private": true,
  "description": "Repository-local CI and semantic-release tooling for RedBird.",
  "scripts": {
    "validate:config": "node scripts/ci/validate-config.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/gitlab": "13.3.3",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "semantic-release": "25.0.9",
    "yaml": "2.9.0"
  }
}
