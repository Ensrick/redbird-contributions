<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>True</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Every package version used anywhere in the solution is pinned exactly once, here.
    Individual csproj files reference packages WITHOUT a Version attribute: <PackageReference Include="Iced" />
  -->
  <ItemGroup>
    <PackageVersion Include="Iced" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="MinHook.NET" Version="1.1.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="PolyHook2.NET" Version="1.1.9" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
</Project>